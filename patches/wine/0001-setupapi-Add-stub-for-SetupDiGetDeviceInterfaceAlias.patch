+{
+    FIXME(": stub %p, %p, %s, %p\n", devinfo, iface_data, debugstr_guid(alias_class), alias_data);
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
