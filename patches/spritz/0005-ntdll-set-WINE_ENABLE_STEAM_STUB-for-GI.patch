From 9af902a524bba410629e64d68c9c743d73bb3cb5 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Sat, 27 Sep 2025 18:06:46 +0200
Subject: [PATCH] ntdll: set WINE_ENABLE_STEAM_STUB for GI

---
 dlls/ntdll/unix/loader.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index b70c24684ef..b8845cff2b1 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1961,6 +1961,10 @@ static void hacks_init(void)
 {
     const char *sgi = getenv( "SteamGameId" );
     const char *env_str;
+
+    if (main_argc > 1 && (strstr(main_argv[1], "GenshinImpact.exe") || strstr(main_argv[1], "YuanShen.exe") || strstr(main_argv[1], "fpsunlock.exe")))
+        setenv( "WINE_ENABLE_STEAM_STUB", "1", 0 );
+
     if ((env_str = getenv("WINE_RAM_REPORTING_BIAS")))
     {
         ram_reporting_bias = atoll(env_str) * 1024 * 1024;
-- 
2.51.0

